{
  "routes": {
    "home": "/",
    "signupPage": "/signup",
    "dashboard": "/dashboard",
    "keys": "/keys",
    "billing": "/billing",
    "loginApi": "/api/auth/login",
    "signupApi": "/api/auth/signup"
  },
  "methods": {
    "create": "POST"
  },
  "navigationMatcher": "/((?!api|_next/static|_next/image|favicon.ico|logo.png|.*\\.svg$).*)",
  "cookie": {
    "name": "forboc_session",
    "sameSite": "lax",
    "path": "/",
    "maxAgeSeconds": 604800
  },
  "jwt": {
    "secretEnvironment": "JWT_SECRET",
    "algorithm": "HS256",
    "expiry": "7d"
  },
  "password": {
    "minimumLength": 8,
    "hashRounds": 12
  },
  "email": {
    "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
  },
  "messages": {
    "credentialsRequired": "Email and password are required",
    "invalidCredentials": "Invalid credentials",
    "passwordTooShort": "Password must be at least 8 characters",
    "invalidEmail": "Invalid email address",
    "identityExists": "An account with this email already exists",
    "internalServer": "Internal server error"
  }
}
