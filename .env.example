# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forboc_account"

# JWT secret for signing auth tokens (generate a strong random string)
JWT_SECRET=""

# Shared auth protection. "local" is explicit and development-only.
AUTH_RATE_LIMIT_PROVIDER="postgres"
AUTH_RATE_LIMIT_HASH_SECRET=""
AUTH_RATE_LIMIT_TRUSTED_PROXY_HOPS="1"
